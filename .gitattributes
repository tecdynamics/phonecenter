# This repo is edited from Windows but RUNS on Linux (tecai1). CRLF in a shell
# script or a systemd unit breaks the shebang and yields status=203/EXEC, so
# every text file is normalised to LF in the working tree, not just in the repo.
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.service text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
.env.example text eol=lf

*.wav binary
*.npz binary
