# ── TecAI Voice Agent — per-client config ─────────────────────────────────
# Copy to .env (or clients/<id>.env) and fill. NEVER commit a filled .env.
# The implementer does NOT fill credentials on your behalf — you do.

CLIENT_ID=tec
COMPANY_NAME=Tec Dynamics LTD

# ── SIP / Zadarma (register as ONE extension; Zadarma is the PBX) ──────────
SIP_SERVER=pbx.zadarma.com
SIP_EXTENSION=000000-000        # your Zadarma extension
SIP_PASSWORD=CHANGEME           # never commit the real one
SIP_TRANSPORT=udp            # udp | tcp | tls
ESCALATION_EXTENSION=200     # default/fallback transfer target
# Department routing — the agent picks the department, mapped to an extension here.
# Format: dept:ext,dept:ext. Falls back to 'general' then ESCALATION_EXTENSION.
TRANSFER_EXTENSIONS=general:103,support:100,sales:302
TRANSFER_ENABLED=true        # allow transferring the live call to a human
TRANSFER_CONFIRM_S=15        # after a REFER, wait this long for the call to drop; else treat transfer as failed + fall back
MAX_CONCURRENT_CALLS=2

# ── Business hours (transfer when open, take a callback when closed) ────────
# Leave BUSINESS_OPEN/CLOSE blank to always allow transfer.
BUSINESS_OPEN=09:00
BUSINESS_CLOSE=17:00
BUSINESS_DAYS=1-5            # ISO weekdays Mon=1..Sun=7 ("1-5" or "1,2,3")
TIMEZONE=Europe/London

# ── Email notifications (SMTP) — leave SMTP_HOST blank to disable ───────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# comma-separated recipients (default ticket inbox)
SMTP_TO=
# Per-department ticket routing — on a transfer, send the transcript to the
# matching department's email instead of SMTP_TO. Format: dept:email,dept:email.
# Departments should match TRANSFER_EXTENSIONS. Falls back to 'general' then SMTP_TO.
# e.g. support:support@x.com,sales:sales@x.com,general:ops@x.com
ESCALATION_EMAILS=
SMTP_USE_TLS=true
SMTP_VERIFY_CERT=true        # set false if the server cert is self-signed / hostname-mismatched
EMAIL_SUMMARY=true           # email a summary when each call ends
EMAIL_ESCALATION=true        # email the team when a call is transferred

# ── Languages (English + Greek only) ────────────────────────────────────────
PRIMARY_LANGUAGE=en
SUPPORTED_LANGUAGES=en,el

# ── Model services (EXISTING on tecai1 — integrate, do not recreate) ────────
# Qwen MoE via the vLLM container on the 2x B70s (OpenAI-compatible), port 8000.
# ⚠️ vLLM VALIDATES the model name and 404s on a mismatch — unlike llama.cpp,
# which ignored it. LLM_MODEL must equal the served id exactly:
#     curl -s http://127.0.0.1:8000/v1/models | jq -r '.data[].id'
LLM_ENDPOINT=http://127.0.0.1:8000/v1
LLM_MODEL=tecai              # the id vLLM currently serves; re-check /v1/models if it changes
# vLLM only checks this if started with --api-key
LLM_API_KEY=
LLM_TEMPERATURE=0.35         # spec §5.4
LLM_TOP_P=0.9
LLM_MAX_TOKENS=220           # keep replies short → lower time-to-first-audio
LLM_TIMEOUT=30
LLM_HISTORY_BUDGET_TOKENS=4000   # raise only if the served ctx window allows
FIRST_CLAUSE_MAX_CHARS=70    # short first clause = faster first audio; 0 disables
EMBEDDING_ENDPOINT=http://127.0.0.1:8081  # multilingual-e5-large (phase 3)
XTTS_ENDPOINT=http://127.0.0.1:8087       # TecAI tts-server (OpenAI-compatible)
XTTS_PATH=/v1/audio/speech/public         # public no-auth route (input capped ~1000 chars)
# only needed if XTTS_PATH=/v1/audio/speech (token-gated route)
XTTS_API_KEY=
XTTS_MODEL=tts-1
XTTS_RESPONSE_FORMAT=wav     # keep wav — the client parses WAV
XTTS_TIMEOUT=30              # per-request TTS timeout (s); VoxCPM Greek can exceed 15s and drop audio
XTTS_SPEED=1.0               # speaking rate: <1.0 slower/calmer (try 0.9 if rushed), >1.0 faster
XTTS_VOICE_EL=el_female_1
XTTS_VOICE_EN=en_female_1

# ── ASR (faster-whisper) ───────────────────────────────────────────────────
# large-v3 is the deliberate default: max quality for el/en/ar, ~3.1 GB VRAM.
# large-v3-turbo is ~4-8x faster and ~2x lighter (~1.6 GB) but weaker on Greek
# and Arabic — switch only if the 12 GB budget or the <800 ms target demands it.
ASR_MODEL=large-v3
ASR_DEVICE=cuda # cuda | cpu
# GPU ordinal as seen BY THIS PROCESS, or 'auto' (most free VRAM), or set
# ASR_DEVICE=cpu. tecai1 has exactly ONE CUDA device (the RTX 5070) and the
# systemd unit pins CUDA_VISIBLE_DEVICES=0, so this is 0. The B70s running vLLM
# are not CUDA devices and are never addressable here. A bad index fails with a
# clear error naming the visible device count, not CUDA's "invalid device ordinal".
ASR_DEVICE_INDEX=0
ASR_COMPUTE_TYPE=int8_float16   # cuda: int8_float16 | float16 ; cpu: int8

# ── Acoustic echo cancellation (needs `speexdsp` on the server) ─────────────
# Removes the agent's own TTS echoing back on the line so Whisper doesn't hear
# phantom turns and barge-in doesn't flush the agent's reply. Falls back to a
# no-op (with a warning) if speexdsp is missing. Required before BARGEIN_ENABLED.
AEC_ENABLED=true
AEC_TAIL_MS=200              # adaptive filter length; must exceed worst-case line echo delay (~100-250 ms)

# ── VAD / endpointing (tunable; latency-sensitive) ─────────────────────────
# End-of-turn silence. Real PSTN/VoIP trunks have jitter + DTX gaps between
# words — 800 ms avoids cutting callers mid-sentence (clean internal lines can
# go lower for snappier turns, ~450). If the caller still gets chopped, raise to
# 1000; if replies feel laggy after they stop, ease toward 700.
VAD_SILENCE_MS=800
VAD_THRESHOLD=0.5            # Silero speech probability threshold (detection, not endpointing)
VAD_MIN_SPEECH_MS=300        # ignore short noise blips on the trunk
NO_INPUT_TIMEOUT_S=6         # silence before "are you still there?" / ending
BARGEIN_ENABLED=false        # OFF until echo-cancellation exists, else the agent flushes its own audio
BARGEIN_GRACE_MS=500         # (only relevant when barge-in is on) ignore barge-in for first N ms
# Instant short ack spoken while the real reply generates (masks TTS/LLM latency).
THINKING_FILLER_ENABLED=true
# blank = rotating built-in variants per language; or comma-separated list
THINKING_FILLER=

# ── Greeting (fixed + pre-synthesized at startup for an instant opening) ────
# Blank → default greeting using COMPANY_NAME, in the primary language.
GREETING_TEXT=
GREETING_LEAD_SILENCE_MS=400   # silence before the greeting so the first word isn't clipped
REPLY_LEAD_SILENCE_MS=120     # pad before each reply so the first consonant is not clipped

# ── Persona prompt (separate runtime file — NOT in code) ───────────────────
SYSTEM_PROMPT_PATH=docs/voice_support_agent_prompt.md
# These fill the {PLACEHOLDER}s in the prompt at load time. COMPANY_NAME (top)
# fills {COMPANY_NAME}. Leave a value blank to keep its {PLACEHOLDER} literal
# (you'll get a startup warning listing what's still unfilled).
AGENT_NAME=Rob                # fallback if no per-language name matches
AGENT_NAME_EN=Rob            # English callers
AGENT_NAME_EL=Nina           # Greek callers
BUSINESS_DOMAIN=e-commerce
BUSINESS_HOURS=Mon-Fri 09:00-17:00 EET
SUPPORTED_TOPICS=order status, delivery, product info, returns, store hours
OUT_OF_SCOPE_TOPICS=payments by phone, complaints requiring a manager, legal matters
# blank → "transfer to extension {ESCALATION_EXTENSION}"
ESCALATION_PATH=
PRICE_POLICY=read_aloud
FOLLOWUP_CHANNEL=SMS
VERIFICATION_RULE=confirm full name plus order number
# none yet (phase 3+)
TOOLS_AVAILABLE=

# ── RAG (phase 3) ───────────────────────────────────────────────────────────
# Build an index first:  python -m voice_agent.rag.ingest --src data/zai --out indexes/zai.npz
# Then point RAG_INDEX at it. Empty = RAG off (agent escalates for facts).
# e.g. indexes/zai.npz
RAG_INDEX=
RAG_TOP_K=4
RAG_MIN_SCORE=0.80           # e5 cosine cutoff; lower = more (looser) matches
EMBEDDING_ENDPOINT=http://127.0.0.1:8081
EMBEDDING_MODEL=multilingual-e5-large
EMBEDDING_PATH=/v1/embeddings   # CONFIRM the e5 server's contract
EMBEDDING_ADD_PREFIXES=true      # e5 requires query:/passage: prefixes

# ── Privacy ─────────────────────────────────────────────────────────────────
RECORD_AUDIO=false           # GDPR: off by default
LOG_TRANSCRIPTS=false
